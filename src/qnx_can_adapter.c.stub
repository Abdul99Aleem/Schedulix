static int g_can_fd = -1;

void can_adapter_init(void) {
    /* Example: open driver device */
    g_can_fd = open("/dev/can1", O_RDWR);
    if (g_can_fd < 0) {
        perror("open /dev/can1");
    }

    /* Any driver-specific init (bitrate, filters) would go here via ioctl() */
}

void can_adapter_shutdown(void) {
    if (g_can_fd >= 0) close(g_can_fd);
    g_can_fd = -1;
}

